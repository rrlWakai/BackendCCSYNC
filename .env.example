APP_NAME="CCSync API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_VERSION=v1
INSTITUTIONAL_EMAIL_DOMAINS=lspu.edu.ph

# Campus timezone used to interpret class schedules and attendance times.
ATTENDANCE_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ccsync_db
DB_USERNAME=ccsync_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_ADMIN_URL=http://localhost:5173
FRONTEND_CLASSFLOW_URL=http://localhost:5174

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174

# -----------------------------------------------------------------------------
# Production (Render + Aiven + Vercel)
# Set these in Render. Do not include quotes or whitespace around DB_HOST/DB_PORT.
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:REPLACE_WITH_A_NEW_UNIQUE_APPLICATION_KEY
# APP_URL=https://backendccsync.onrender.com
# DB_CONNECTION=mysql
# DB_HOST=YOUR_AIVEN_MYSQL_HOST
# DB_PORT=YOUR_AIVEN_MYSQL_PORT
# DB_DATABASE=YOUR_AIVEN_DATABASE
# DB_USERNAME=YOUR_AIVEN_USERNAME
# DB_PASSWORD=YOUR_AIVEN_PASSWORD
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=/var/www/html/certs/aiven-ca.pem
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true
# SESSION_DRIVER=database
# SESSION_LIFETIME=120
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=none
# CACHE_STORE=database
# SANCTUM_STATEFUL_DOMAINS=ccsync-eight.vercel.app,classflow-seven-coral.vercel.app
# FRONTEND_ADMIN_URL=https://ccsync-eight.vercel.app
# FRONTEND_CLASSFLOW_URL=https://classflow-seven-coral.vercel.app
# RUN_MIGRATIONS=false
# ATTENDANCE_TIMEZONE=Asia/Manila

# Required only when running the guarded development account seeder.
CCSYNC_SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
